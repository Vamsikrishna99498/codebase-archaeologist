# Copy to .env and fill in. Never commit .env.

# OpenRouter (free models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub fine-grained token, read-only "Contents" + "Metadata" on public repos.
# Raises API limits from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Supabase Postgres connection string (pooled), used for pgvector + metadata.
SUPABASE_DB_URL=

# Optional overrides
# LOG_LEVEL=INFO
# MAX_FILES=2000
