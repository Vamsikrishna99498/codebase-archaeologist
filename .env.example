# Copy to .env and fill in. Never commit .env.

# OpenRouter (free models) - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# GitHub fine-grained token, read-only "Contents" + "Metadata" on public repos.
# Raises API limits from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Supabase Postgres connection string (Session pooler), used for pgvector + metadata.
SUPABASE_DB_URL=

# Supabase over HTTPS, for networks that block port 5432 (Project Settings -> API Keys).
# The secret/service_role key bypasses row-level security: keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# auto (default) | postgres | rest | memory
# STORAGE_BACKEND=auto

# Optional overrides
# LOG_LEVEL=INFO
# MAX_FILES=2000
